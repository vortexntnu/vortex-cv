<?xml version="1.0"?>
<!-- RoboSub task subtree, included by ../main.xml. Plan section: octagon. -->
<root BTCPP_format="4">
  <BehaviorTree ID="Octagon">
    <Sequence>
      <ForceSuccess>
        <Timeout msec="60000">
          <GoToCourse x="{octagon_area_x}" y="{octagon_area_y}" z="{travel_depth}" position_tolerance="0.5"/>
        </Timeout>
      </ForceSuccess>
      <Timeout msec="20000">
        <SetDepth z="0.9" position_tolerance="0.3" hold_s="1.0"/>
      </Timeout>
      <ReactiveFallback name="FindTable">
        <LandmarkKnown type="TABLE" subtype="TABLE_WHOLE" max_age_s="5.0"/>
        <LandmarkKnown type="OCTAGON" subtype="OCTAGON_WHOLE" max_age_s="5.0"/>
        <Timeout msec="60000">
          <Search pattern="EXPANDING_SQUARE" step_m="1.5" max_m="6.0"/>
        </Timeout>
      </ReactiveFallback>
      <RetryUntilSuccessful num_attempts="2">
        <Sequence name="CenterAndSurface">
          <Timeout msec="40000">
            <ApproachLandmark type="OCTAGON" subtype="OCTAGON_WHOLE" frame="LANDMARK_ODOM_AXES" mode="XY_AND_YAW"
                              position_tolerance="0.3" hold_s="1.0"/>
          </Timeout>
          <ForceSuccess>
            <Timeout msec="30000">
              <ApproachLandmark type="TABLE" subtype="TABLE_WHOLE" frame="LANDMARK_ODOM_AXES" mode="XY_AND_YAW"
                                tool_frame="downwards_camera_link"
                                position_tolerance="0.07" orientation_tolerance_deg="10" hold_s="1.5"/>
            </Timeout>
          </ForceSuccess>
          <VerifyInside type="OCTAGON" subtype="OCTAGON_WHOLE" pose="{pose}" radius_m="1.35" margin_m="0.3"/>
          <Timeout msec="30000">
            <Surface z="0.2" position_tolerance="0.3" hold_s="3.0"/>
          </Timeout>
        </Sequence>
      </RetryUntilSuccessful>
      <ForceSuccess>
        <Sequence name="FaceImage">
          <ReactiveFallback>
            <LandmarkKnown type="OCTAGON" subtype="{octagon_image_subtype}" max_age_s="60" id="{image_id}"/>
            <Timeout msec="30000">
              <Search pattern="ROTATE_STEPS" step_deg="45" pause_s="1.0" rounds="1"/>
            </Timeout>
          </ReactiveFallback>
          <Timeout msec="20000">
            <LookAtLandmark id="{image_id}" orientation_tolerance_deg="10" hold_s="2.0"/>
          </Timeout>
        </Sequence>
      </ForceSuccess>
      <ForceSuccess _skipIf="octagon_items_enabled == false">
        <SubTree ID="OctagonItems" _autoremap="true"/>
      </ForceSuccess>
      <Timeout msec="20000">
        <SetDepth z="0.8" position_tolerance="0.3" hold_s="1.0"/>
      </Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="OctagonItems">                         <!-- stretch goal, off by default -->
    <Sequence>
      <SelectLandmark type="TABLE" subtype="{table_item_subtype}" sort="NEAREST" id="{item_id}"/>
      <Timeout msec="30000">
        <ApproachLandmark id="{item_id}" frame="LANDMARK_ODOM_AXES" z="-0.05" tool_frame="gripper_link"
                          position_tolerance="0.07" orientation_tolerance_deg="10" hold_s="1.5"/>
      </Timeout>
      <SetGripper state="closed"/>
      <SelectLandmark type="TABLE" subtype="{basket_subtype}" sort="NEAREST" id="{basket_id}"/>
      <Timeout msec="30000">
        <ApproachLandmark id="{basket_id}" frame="LANDMARK_ODOM_AXES" z="-0.2" tool_frame="gripper_link"
                          position_tolerance="0.1" hold_s="1.0"/>
      </Timeout>
      <SetGripper state="open"/>
    </Sequence>
  </BehaviorTree>
</root>
