<?xml version="1.0"?>
<!-- RoboSub task subtree, included by ../main.xml. Plan section: slalom. -->
<root BTCPP_format="4">
  <BehaviorTree ID="Slalom">
    <Sequence>
      <Timeout msec="30000">
        <SetDepth z="{slalom_depth}" position_tolerance="0.2" hold_s="1.0"/>
      </Timeout>
      <Fallback name="Strategy">
        <Sequence name="Nominal">
          <ReactiveFallback name="FindPipes">
            <LandmarkKnown type="SLALOM_PIPE" subtype="SLALOM_PIPE_RED" max_age_s="3.0" min_forward_m="1.0"/>
            <LandmarkKnown type="SLALOM_PIPE" subtype="SLALOM_PIPE_WHITE" max_age_s="3.0" min_forward_m="1.0"/>
            <Timeout msec="30000">
              <Search pattern="SCAN_ARC" arc_deg="60" pause_s="1.0" rounds="2"/>
            </Timeout>
          </ReactiveFallback>
          <Script code="layer := 0"/>
          <Repeat num_cycles="3">
            <Sequence>
              <ForceSuccess>
                <Fallback name="Layer">
                  <Sequence name="LayerNominal">
                    <Fallback name="ScanOrSkip">
                      <Sequence name="SkipScan">
                        <ScriptCondition code="layer &gt; 0"/>
                        <LandmarkKnown type="SLALOM_PIPE" subtype="SLALOM_PIPE_RED" max_age_s="2.0"
                                       min_forward_m="1.0" max_forward_m="3.0" exclude="{passed_red_ids}"/>
                      </Sequence>
                      <Timeout msec="20000">
                        <Search pattern="SCAN_ARC" arc_deg="40" pause_s="1.0" rounds="1"/>
                      </Timeout>
                    </Fallback>
                    <RetryUntilSuccessful num_attempts="10">
                      <Sequence>
                        <Sleep msec="100"/>
                        <MatchPipes map="{map}" pose="{pose}" gate_side="{gate_side}" exclude="{passed_red_ids}"
                                    offset="{slalom_offset}" gap_pose="{gap_pose}" red_id="{red_id}"
                                    min_forward_m="1.0" collinearity_m="0.5" min_separation_m="0.5" inward_deg="15"/>
                      </Sequence>
                    </RetryUntilSuccessful>
                    <Timeout msec="45000">
                      <GoTo pose="{gap_pose}" mode="POSITION_AND_YAW"
                            position_tolerance="0.3" orientation_tolerance_deg="20" hold_s="1.0"/>
                    </Timeout>
                    <Timeout msec="15000">
                      <MoveRelative frame="BODY_RELATIVE" x="1.0" position_tolerance="0.3"/>
                    </Timeout>
                    <RecordLayer pose="{pose}" red_id="{red_id}" layers="{slalom_layers}" passed="{passed_red_ids}"/>
                  </Sequence>
                  <Timeout msec="20000">
                    <MoveCourse dx="2.0" position_tolerance="0.4"/>   <!-- blindt lag -->
                  </Timeout>
                </Fallback>
              </ForceSuccess>
              <Script code="layer += 1"/>
            </Sequence>
          </Repeat>
        </Sequence>
        <Timeout msec="45000">
          <MoveCourse dx="6.0" position_tolerance="0.5"/>              <!-- total failsafe -->
        </Timeout>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
