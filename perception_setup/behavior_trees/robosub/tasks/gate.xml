<?xml version="1.0"?>
<!-- RoboSub task subtree, included by ../main.xml. Plan section: gate. -->
<root BTCPP_format="4">
  <BehaviorTree ID="Gate">
    <Sequence>
      <Timeout msec="30000">
        <SetDepth z="{gate_depth}" position_tolerance="0.3" hold_s="2.0"/>
      </Timeout>
      <Fallback name="PassGate">
        <Sequence name="Nominal">
          <ReactiveFallback name="FindGate">
            <LandmarkKnown type="GATE" subtype="GATE_WHOLE" max_age_s="2.0" id="{gate_id}"/>
            <Timeout msec="40000">
              <Search pattern="ROTATE_STEPS" step_deg="45" pause_s="1.0" rounds="2"/>
            </Timeout>
          </ReactiveFallback>
          <Timeout msec="8000">
            <SelectGatePanel map="{map}" gate_id="{gate_id}" preferred_role="{preferred_role}"
                             panel_id="{gate_panel_id}" role="{role}" gate_side="{gate_side}"/>
          </Timeout>
          <Timeout msec="40000">
            <ApproachLandmark id="{gate_panel_id}" frame="LANDMARK" x="2.0" yaw_deg="180"
                              position_tolerance="0.3" orientation_tolerance_deg="10" hold_s="1.0"
                              dead_reckoning_m="1.5" track_loss_timeout_s="10"/>
          </Timeout>
          <Timeout msec="20000">
            <MoveRelative frame="BODY_RELATIVE" x="2.5" position_tolerance="0.3" hold_s="0.0"/>
          </Timeout>
        </Sequence>
        <Sequence name="Blind">
          <Script code="role := preferred_role; gate_side := default_gate_side"/>
          <Timeout msec="30000">
            <MoveCourse dx="6.0" z="{gate_depth}" position_tolerance="0.5"/>
          </Timeout>
        </Sequence>
      </Fallback>
      <ForceSuccess _skipIf="style_yaw_turns == 0">
        <Repeat num_cycles="{style_yaw_turns}">
          <Turn relative_deg="90" orientation_tolerance_deg="10" hold_s="0.5"/>
        </Repeat>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>
</root>
