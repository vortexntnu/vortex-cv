<?xml version="1.0"?>
<!-- RoboSub task subtree, included by ../main.xml. Plan section: bins. -->
<root BTCPP_format="4">
  <BehaviorTree ID="Bins">
    <Sequence>
      <ForceSuccess>
        <Timeout msec="60000">
          <GoToCourse x="{bins_area_x}" y="{bins_area_y}" z="{travel_depth}" position_tolerance="0.5"/>
        </Timeout>
      </ForceSuccess>
      <Timeout msec="20000">
        <SetDepth z="{bins_search_depth}" position_tolerance="0.2" hold_s="1.0"/>
      </Timeout>
      <ReactiveFallback name="FindBins">
        <LandmarkKnown type="BIN" subtype="ANY" max_age_s="5.0"/>
        <Timeout msec="60000">
          <Search pattern="LAWNMOWER" legs="2" leg_m="3.0" spacing_m="1.0"/>
        </Timeout>
      </ReactiveFallback>
      <Script code="marker_index := 0"/>
      <Repeat num_cycles="2">
        <Sequence>
          <ForceSuccess>
            <Sequence name="DropOne">
              <Fallback name="PickBin">
                <SelectLandmark type="BIN" subtype="{bin_subtype}" exclude="{used_bins}" sort="NEAREST" id="{bin_id}"/>
                <SelectLandmark type="BIN" subtype="ANY" exclude="{used_bins}" sort="NEAREST" id="{bin_id}"/>
                <SelectLandmark type="BIN" subtype="ANY" sort="NEAREST" id="{bin_id}"/>
              </Fallback>
              <Timeout msec="30000">
                <ApproachLandmark id="{bin_id}" frame="LANDMARK_ODOM_AXES" z="-0.7"
                                  position_tolerance="0.2" orientation_tolerance_deg="20" hold_s="3.0"
                                  track_loss_timeout_s="10"/>
              </Timeout>
              <ForceSuccess>
                <Timeout msec="20000">
                  <ApproachLandmark id="{bin_id}" frame="LANDMARK_ODOM_AXES" z="-0.4" tool_frame="dropper_link"
                                    position_tolerance="0.07" orientation_tolerance_deg="20" hold_s="2.0"
                                    dead_reckoning_m="0.3"/>
                </Timeout>
              </ForceSuccess>
              <RetryUntilSuccessful num_attempts="2">
                <DropMarker index="{marker_index}"/>
              </RetryUntilSuccessful>
              <MarkUsed id="{bin_id}" list="{used_bins}"/>
            </Sequence>
          </ForceSuccess>
          <Script code="marker_index += 1"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>
