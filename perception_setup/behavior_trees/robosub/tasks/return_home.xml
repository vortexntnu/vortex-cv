<?xml version="1.0"?>
<!-- RoboSub task subtree, included by ../main.xml. Plan section: return_home. -->
<root BTCPP_format="4">
  <BehaviorTree ID="ReturnHome">
    <Sequence>
      <ForceSuccess>
        <Fallback name="Strategy">
          <Sequence name="Nominal">
            <SubTree ID="LeaveArea" _autoremap="true"/>
            <Fallback name="PastSlalom">
              <Sequence>
                <AvoidSlalom course_frame="{course_frame}" layers="{slalom_layers}" map="{map}"
                             lane_left_m="{lane_left_m}" lane_right_m="{lane_right_m}"
                             return_distance_m="2.5" path="{avoid_path}"/>
                <Timeout msec="120000">
                  <FollowPoses poses="{avoid_path}" mode="POSITION_AND_YAW" position_tolerance="0.4"/>
                </Timeout>
              </Sequence>
              <Timeout msec="90000">
                <GoToCourse x="2.5" y="0.0" z="{travel_depth}" yaw_deg="180" position_tolerance="0.4"/>
              </Timeout>
            </Fallback>
            <SubTree ID="PassGateBack" _autoremap="true"/>
          </Sequence>
          <Sequence name="SearchForGate">
            <Timeout msec="90000">
              <GoToCourse x="2.5" y="0.0" z="{travel_depth}" yaw_deg="180" position_tolerance="0.5"/>
            </Timeout>
            <ReactiveFallback>
              <LandmarkKnown type="GATE" subtype="GATE_WHOLE" max_age_s="2.0"/>
              <Timeout msec="40000">
                <Search pattern="ROTATE_STEPS" step_deg="60" pause_s="1.0" rounds="2"/>
              </Timeout>
            </ReactiveFallback>
            <SubTree ID="PassGateBack" _autoremap="true"/>
          </Sequence>
          <Sequence name="Failsafe">
            <Timeout msec="20000">
              <SetDepth z="{travel_depth}" position_tolerance="0.3"/>
            </Timeout>
            <Timeout msec="120000">
              <GoToSavedPose saved="{start_pose}" position_tolerance="0.5"/>
            </Timeout>
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <Timeout msec="30000">
        <Surface z="0.2" position_tolerance="0.3" hold_s="3.0"/>
      </Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="LeaveArea">
    <Sequence>
      <Timeout msec="20000"><SetDepth z="0.8" position_tolerance="0.3" hold_s="1.0"/></Timeout>
      <Timeout msec="30000"><MoveCourse dx="-2.0" position_tolerance="0.4"/></Timeout>
      <Timeout msec="20000"><SetDepth z="{travel_depth}" position_tolerance="0.3" hold_s="1.0"/></Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PassGateBack">
    <Sequence>
      <Timeout msec="20000">
        <SetDepth z="{gate_depth}" position_tolerance="0.3" hold_s="1.0"/>
      </Timeout>
      <Timeout msec="40000">
        <ApproachLandmark type="GATE" subtype="GATE_WHOLE" frame="LANDMARK" x="-2.0" yaw_deg="0"
                          position_tolerance="0.3" orientation_tolerance_deg="10" hold_s="1.0"
                          dead_reckoning_m="1.5" track_loss_timeout_s="10"/>
      </Timeout>
      <Timeout msec="20000">
        <MoveRelative frame="BODY_RELATIVE" x="3.0" position_tolerance="0.3"/>
      </Timeout>
    </Sequence>
  </BehaviorTree>
</root>
