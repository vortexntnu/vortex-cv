<?xml version="1.0"?>
<!--
  RoboSub mission, BehaviorTree.CPP v4. Main tree, safety and the task order.
  Each task is a subtree in tasks/<task>.xml, included below.
  Reference design: the RoboSub course tree plan (sections 1-7). The nodes
  (PoseFeeder, TaskSlot, ApproachLandmark, ...) are specified in section 8 of
  the plan and are not implemented yet, so this tree does not load until they
  are registered.
-->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <include path="tasks/gate.xml"/>
  <include path="tasks/slalom.xml"/>
  <include path="tasks/bins.xml"/>
  <include path="tasks/torpedo.xml"/>
  <include path="tasks/octagon.xml"/>
  <include path="tasks/return_home.xml"/>

  <BehaviorTree ID="Main">
    <Fallback name="RunOrSafeStop">
      <ReactiveSequence name="Run">
        <PoseFeeder topic="pose" pose="{pose}" max_age_s="0.5"/>
        <MapFeeder topic="landmark_server/object_map" map="{map}" max_age_s="1.0"/>
        <CourseFrameFeeder frame="nautilus/course" course_frame="{course_frame}"/>
        <VehicleHealthy pose="{pose}" max_depth_m="{max_depth_m}"/>
        <SubTree ID="Mission" _autoremap="true"/>
      </ReactiveSequence>
      <SubTree ID="SafeStop" _autoremap="true"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Mission">
    <Sequence>
      <LoadMissionConfig path="config/mission/robosub/mission.yaml"/>
      <Wait seconds="{startup_delay_s}"/>
      <SetOperationMode mode="autonomous"/>
      <ResetWorld/>                                   <!-- mission/wipe + landmark_server/clear -->
      <SavePose pose="{pose}" saved="{start_pose}"/>
      <StartRun start_pose="{start_pose}" heading_offset_deg="{coin_flip_offset_deg}"/>
      <MissionClock run_time_s="{run_time_s}" clock="{mission_clock}"/>
      <RecordBag profile="all">
        <Sequence>
          <TaskSlot task="Gate" clock="{mission_clock}" budget_s="{gate_budget_s}" reserve_s="{reserve_after_gate_s}">
            <RetryUntilSuccessful num_attempts="2">
              <SubTree ID="Gate" _autoremap="true"/>
            </RetryUntilSuccessful>
          </TaskSlot>
          <ResolveRole role="{role}"
                       bin_subtype="{bin_subtype}"
                       torpedo_large="{torpedo_large_subtype}" torpedo_large_other="{torpedo_large_other_subtype}"
                       torpedo_small="{torpedo_small_subtype}" torpedo_small_other="{torpedo_small_other_subtype}"
                       octagon_image="{octagon_image_subtype}"/>
          <TaskSlot task="Slalom" clock="{mission_clock}" budget_s="{slalom_budget_s}" reserve_s="{reserve_after_slalom_s}">
            <SubTree ID="Slalom" _autoremap="true"/>
          </TaskSlot>
          <TaskSlot task="Bins" clock="{mission_clock}" budget_s="{bins_budget_s}" reserve_s="{reserve_after_bins_s}">
            <SubTree ID="Bins" _autoremap="true"/>
          </TaskSlot>
          <TaskSlot task="Torpedo" clock="{mission_clock}" budget_s="{torpedo_budget_s}" reserve_s="{reserve_after_torpedo_s}">
            <SubTree ID="Torpedo" _autoremap="true"/>
          </TaskSlot>
          <TaskSlot task="Octagon" clock="{mission_clock}" budget_s="{octagon_budget_s}" reserve_s="{reserve_after_octagon_s}">
            <SubTree ID="Octagon" _autoremap="true"/>
          </TaskSlot>
          <TaskSlot task="ReturnHome" clock="{mission_clock}" budget_s="{return_budget_s}" reserve_s="0">
            <SubTree ID="ReturnHome" _autoremap="true"/>
          </TaskSlot>
        </Sequence>
      </RecordBag>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SafeStop">
    <Sequence>
      <LogError message="Run stoppet: pose, kart eller helse feilet"/>
      <HoldPosition seconds="-1"/>                    <!-- kontrolleren holder siste referanse uansett -->
    </Sequence>
  </BehaviorTree>

</root>
