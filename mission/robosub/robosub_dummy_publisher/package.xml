<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robosub_dummy_publisher</name>
  <version>0.0.0</version>
  <description>Seeded dummy LandmarkArray publishers standing in for perception on each RoboSub course element (gate, slalom, torpedo board, bins), for testing landmark_server and mission logic without a running perception stack.</description>
  <maintainer email="Hinthu5@hotmail.no">hinthujan</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>vortex_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>auv_setup</exec_depend>

  <test_depend>landmark_server</test_depend>
  <test_depend>landmark_targets</test_depend>
  <test_depend>waypoint_manager</test_depend>
  <test_depend>reference_filter_dp_quat</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
