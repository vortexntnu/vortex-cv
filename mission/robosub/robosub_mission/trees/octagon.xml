<?xml version="1.0"?>
<!-- Octagon: find the table, go above it and surface inside the octagon. -->
<root BTCPP_format="4">
  <BehaviorTree ID="Octagon">
    <Sequence>
      <Timeout msec="90000"><SetDepth z="{travel_depth}"/></Timeout>
      <Timeout msec="120000"><GoToFrame frame="prior_table" offset="{octagon_search}" position_tolerance="0.4"/></Timeout>
      <Timeout msec="90000">
        <ReactiveFallback name="FindTable">
          <LandmarkConfirmed type="TABLE" subtype="TABLE_WHOLE" max_sigma_xy="0.3"/>
          <Search pattern="ROTATE_STEPS" step_deg="45"/>
        </ReactiveFallback>
      </Timeout>
      <Timeout msec="120000"><GoToFrame frame="table" offset="{octagon_hover}" position_tolerance="0.25" hold_s="1.0" freeze_within_m="0.5"/></Timeout>
      <Timeout msec="90000"><Surface z="{surface_depth}"/></Timeout>
      <Sleep msec="3000"/>
      <Timeout msec="90000"><SetDepth z="{travel_depth}"/></Timeout>
      <Log message="octagon: surfaced inside"/>
    </Sequence>
  </BehaviorTree>
</root>
