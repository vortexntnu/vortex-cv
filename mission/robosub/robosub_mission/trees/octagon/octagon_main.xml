<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="Octagon_Main">
        <Sequence>
           <GoToFrame name="find" frame="octagon" offset="3;0;0;180" position_tolerance="0.5" orientation_tolerance_deg="15"/>
