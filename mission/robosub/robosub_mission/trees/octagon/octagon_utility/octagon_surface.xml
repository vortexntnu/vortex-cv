<?xml version="1.0"?>
<root BTCPP_format="4">
    <!-- From over the table (Octagon_Main), straight up. Diving back down is its own tree. -->
    <BehaviorTree ID="Octagon_Surface">
        <Sequence>
            <GoToFrame name="center" frame="table/measured" offset="0;0;-0.5;0" position_tolerance="0.2" orientation_tolerance_deg="15" hold_s="2"/>

            <ForceSuccess>
                <Timeout msec="20000">
                    <SetDepth name="surface" z="0.0" position_tolerance="0.2"/>
                </Timeout>
            </ForceSuccess>
            <Wait seconds="2"/>
        </Sequence>
    </BehaviorTree>
</root>
